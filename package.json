{
  "name": "website",
  "version": "1.0.0",
  "repository": "https://github.com/sean-krail/website",
  "author": "Sean Krail <sean@krail.dev>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "yarn clean && parcel build src/*.html",
    "start": "yarn clean && parcel src/*.html",
    "clean": "yarn rimraf .parcel-cache/ dist/",
    "format": "eslint --fix src/ --ext .js,.jsx,.ts,.tsx && prettier --write src/",
    "format-check": "eslint src/ --ext .js,.jsx,.ts,.tsx && prettier --check src/",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@fontsource/lato": "^5.2.6",
    "@fontsource/material-icons": "^5.2.5",
    "@fontsource/material-icons-outlined": "^5.2.6",
    "@fontsource/raleway": "^5.2.6",
    "@fontsource/roboto-mono": "^5.2.6",
    "@parcel/compressor-brotli": "^2.15.4",
    "@parcel/compressor-gzip": "^2.15.4",
    "@parcel/config-default": "^2.15.4",
    "@parcel/core": "^2.15.4",
    "@parcel/transformer-image": "^2.15.4",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "babel-types": "^6.26.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.34.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-parcel": "^1.10.6",
    "eslint-plugin-import": "^2.32.0",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "node-gyp": "^11.4.1",
    "normalize.css": "^8.0.1",
    "parcel": "^2.15.4",
    "pinst": "^3.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "src/**/*.{css,html,ts}": [
      "prettier --write"
    ]
  },
  "browserslist": "defaults",
  "packageManager": "yarn@4.1.0"
}
